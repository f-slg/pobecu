doi: 10.32614/CRAN.package.pobecu
license: MIT
url: "https://f-slg.github.io/pobecu/"
repository-code: "https://github.com/f-slg/pobecu"
repository: "https://CRAN.R-project.org/package=pobecu"
keywords:
  - R
  - Ecuador
  - population
  - demography
  - population projections
  - DPA
  - public health
references:
